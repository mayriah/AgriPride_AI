# Copy this file to .env and fill in your API keys.
# Only the primary provider is mandatory; fallbacks are used automatically on rate-limit.

ENV=development
STREAMLIT_PORT=8501

# --- Primary LLM: Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Fallback LLM 1: Cohere (https://dashboard.cohere.com/api-keys) ---
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=command-a-03-2025

# --- Fallback LLM 2: Cerebras (https://cloud.cerebras.ai) ---
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=gpt-oss-120b

# --- Provider fallback order (comma-separated) ---
LLM_PROVIDER_ORDER=gemini,cohere,cerebras
